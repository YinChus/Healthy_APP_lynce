import SwiftUI

struct CaptureView: View {
  
        @State private var recognizedObject: String = ""
        @State private var recognizedConfidence: Double = 0.0
        @State var showingDetails = false
        @State var currentShowingObject = ""
        let results: [String] = ["Apple"]

        var body: some View {
            VStack(spacing: 20) {
                
                SwiftUIAVCaptureVideoPreviewView(recognizedObject: $recognizedObject, recognizedConfidence: $recognizedConfidence)
                    .ignoresSafeArea(.all, edges: .all)
                    .overlay(
                        
                            
                            
                            VStack {
                                Spacer()
                                VStack(alignment: .center, spacing: 8) {
                                    if recognizedConfidence>0.8 {
                                        
                                        if results.contains(recognizedObject) {
                                           
                                            Button{
                                                currentShowingObject = recognizedObject
                                                showingDetails=true
                                            }label: {
                                                HStack(spacing: 12){
                                                    Image(recognizedObject)
                                                        .resizable()
                                                        .scaledToFill()
                                                        .frame(width: 50,height: 50)
                                                        .clipped()
                                                        .cornerRadius(5)
                                                    Text("\(recognizedObject)")
                                                        .font(.title)
                                                        
                                                    Image(systemName: "chevron.forward")
                                                        
                                                    
                                                }
                                                
                                                .foregroundColor(.white)
                                                .padding(10)
                                                .background(ThemeColor.tint)
                                                .cornerRadius(10)
                                                
                                            }
                                           
                                           
                                        }
                                        else{
                                            Text("暂未有结果")
                                        }
                                        
                                    }else{
                                        Text("暂未有结果")
                                    }
                                    
                                }
                                .padding(.bottom, 40)
                                .sheet(isPresented: $showingDetails){
                                    
                                   
                                        if let matchingItem = AllFoodItems.first(where: {$0.imageName == currentShowingObject}){
                                            VStack(alignment: .trailing){
                                                
                                                Button("返回"){
                                                    showingDetails = false
                                                }
                                                .padding()
                                                .bold()
                                                
                                            ScrollView{
                                                FoodKnowledgeView(foodItem: matchingItem)
                                            }
                                        }
                                    }
                                    
                                    
                                }
                                
                            }
                        
                    )
                
                // Add other UI components as needed.
                
            }
        }
    

 
}



