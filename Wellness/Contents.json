struct TestListCard: View {
    
    let title:String
    let intro:String
    let number:Int
    let imageName:String
    
    var body: some View {
        
        HStack(alignment:.bottom){
            Image(imageName)  // 从 Assets 中加载图片
                .resizable()
                    .scaledToFill()  // 填充整个frame，但可能会裁剪
                    .frame(width: 120, height: 120)
                    .clipped()  // 确保图片不超出框架
                    .cornerRadius(10)
            
            
            VStack{
                HStack{
                    VStack(alignment: .leading,spacing: 10){
                        Text(title)
                            .font(.title2)
                            .bold()
                        Text(intro)
                    }
                    Spacer()
                }
                .padding(.bottom)
                
                HStack{
                    Text("共\(number)问")
                        .padding(8)
                        .background(ThemeColor.tint.opacity(0.2))
                        .cornerRadius(20)
                    
                    Spacer()
                    Text("开始测评")
                        .padding(8)
                        .background(ThemeColor.tint)
                        .foregroundColor(.white)
                        .cornerRadius(20)
                    
                }
                .font(.footnote)
                
            }
        }
        .padding(.trailing)
        
    }
}

