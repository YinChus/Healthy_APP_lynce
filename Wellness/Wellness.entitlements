import SwiftUI


struct SolarTermView: View {
    let isShowingDetails: Bool
    
    var body: some View {
        let currentSolarTerm = getCurrentSolarTerm()
        
        ZStack{
           
            Rectangle()
                .foregroundColor(currentSolarTerm.color)
            
            VStack {
                
                Spacer()
                Text(currentSolarTerm.name)
                    .font(.title)
                    .bold()
                Text(currentSolarTerm.greetings)
                    .bold()
                 Spacer()
                
                
                if isShowingDetails{
                    Text(currentSolarTerm.details)
                    Spacer()
                }
                
                    
                
            }
            .foregroundColor(.white)
            .padding(20)
        }
        .ignoresSafeArea()
        
        
    }
}

func getCurrentSolarTerm() -> SolarTerm {
    // 获取当前日期
    let date = Date()
    let calendar = Calendar.current
    let month = calendar.component(.month, from: date)
    let day = calendar.component(.day, from: date)
    
    // 基于当前日期计算节气（简化版）
    switch month {
    case 1:
        return day < 20 ? solarTerms[22] : solarTerms[23] // 小寒 or 大寒
    case 2:
        return day < 19 ? solarTerms[0] : solarTerms[1] // 立春 or 雨水
    case 3:
        return day < 21 ? solarTerms[2] : solarTerms[3] // 惊蛰 or 春分
    case 4:
        return day < 20 ? solarTerms[4] : solarTerms[5] // 清明 or 谷雨
    case 5:
        return day < 21 ? solarTerms[6] : solarTerms[7] // 立夏 or 小满
    case 6:
        return day < 21 ? solarTerms[8] : solarTerms[9] // 芒种 or 夏至
    case 7:
        return day < 23 ? solarTerms[10] : solarTerms[11] // 小暑 or 大暑
    case 8:
        return day < 23 ? solarTerms[12] : solarTerms[13] // 立秋 or 处暑
    case 9:
        return day < 23 ? solarTerms[14] : solarTerms[15] // 白露 or 秋分
    case 10:
        return day < 23 ? solarTerms[16] : solarTerms[17] // 寒露 or 霜降
    case 11:
        return day < 22 ? solarTerms[18] : solarTerms[19] // 立冬 or 小雪
    case 12:
        return day < 22 ? solarTerms[20] : solarTerms[21] // 大雪 or 冬至
    default:
        return solarTerms[0] // 立春
    }
}
let solarTerms = [
    SolarTerm(name: "立春", greetings: "春风又绿江南岸，春来江水绿如蓝。", details:"""
斗指东北，维为立春，时春气始至，四时之卒始，故名立春。阳历2月4日前后是二十四节气中的第一个节气。

立春时节养生着重要顺应春天阳气生发、万物始生的特点。

春属木，与肝相应。在春季养生方面，主要是护肝，食品则应选择辛湿发散的大枣、豆豉、葱、花生等，可以达到很好的食疗效果。

立春的饮食药膳应以“升补”为主，适宜的膳食有首乌肝片、虾仁韭菜、珍珠三鲜汤等，食之有补肝肾、益精血、乌发明目、温中益气的功效。
""" ,color: Color(red:213/255,green:235/255,blue:225/255)),
    SolarTerm(name: "雨水", greetings: "雨水到，万物生。", details: """
斗指壬为雨水时，东风解冻，冰雪皆散而为水，化而为雨，故名雨水。时值公历2月18日前后。

五行中肝属木，味为酸，脾属土，味为甘，木胜土。所以，雨水时节的饮食应少吃酸味，多吃甜味，以养脾脏之气。

可选择香椿、百合、豌豆苗、茼蒿、荠菜、春笋、山药、藕、芋头、萝卜、荸荠、甘蔗等。
""", color: Color(red:192/255,green:214/255,blue:149/255)),
    SolarTerm(name: "惊蛰", greetings: "冬眠之物将苏醒。", details: """
斗指丁为惊蛰，雷鸣动，蛰虫皆震起而出，故名惊蛰也。每年阳历3月6日左右时二十四节气的惊蛰。

饮食调养：应多食壮阳食品，如羊肉、狗肉、鸡肉、鹿肉等。

惊蛰的饮食原则是保阴潜阳，多吃清淡食物，也可以适当选用补品，以提高人体的免疫力，还可以适当食用一些具有补益正气作用的食疗粥来增强体质。

维生素对人体的生理功能有着重要的作用，特别是维生素C的摄入能够明显提高人体的抗病能力，维生素C含量丰富的食物有：水萝卜、辣椒、甜椒、西兰花、桂圆、荔枝等。

还应多吃清淡食物：如糯米、芝麻、甘蔗等。一般选服具有调血补气、健脾补肾、养肺补脑的补品。
""", color: Color(red:154/255,green:167/255,blue:177/255)),
    SolarTerm(name: "春分", greetings: "白昼黑夜平分，万物吐绿。",  details: "",color: Color(red:0/255,green:113/255,blue:117/255)),
    SolarTerm(name: "清明", greetings: "清明时节雨纷纷，路上行人欲断魂。", details: "", color: Color(red:121/255,green:131/255,blue:108/255)),
    SolarTerm(name: "谷雨", greetings: "春雨滋润，百谷开始生长。", details: "", color: Color(red:104/255,green:148/255,blue:92/255)),
    SolarTerm(name: "立夏", greetings: "夏日已来，万物焕发生机。", details: "", color: Color(red:223/255,green:206/255,blue:180/255)),
    SolarTerm(name: "小满", greetings: "小满时节，稻谷渐满。", details: "", color: Color(red:211/255,green:162/255,blue:55/255)),
    SolarTerm(name: "芒种", greetings: "芒种时节，农夫播种忙。", details: "", color: Color(red:221/255,green:187/255,blue:153/255)),
    SolarTerm(name: "夏至", greetings: "白昼最长，炎炎夏日。", details: "", color: Color(red:203/255,green:82/255,blue:62/255)),
